# Eidolon Web Client 环境变量
#
# 用法：cp .env.local.example .env.local
# 默认值对应仓库根 .env 的 dev 本机配置（LiveKit 7880, Hub API 8081）；
# 部署到其它环境时改成对应的 ws(s):// 与 http(s):// 地址。
# 注意：NEXT_PUBLIC_* 在构建时嵌入 JS，改完需重新构建（dev 模式下重启 next dev 即可）。

# =============================================
# LiveKit 配置
# =============================================
# 浏览器直接连 LiveKit 的信令地址（须为 ws:// 或 wss://）
# 局域网调试可改成 ws://<本机 LAN IP>:7880
NEXT_PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880

# Hub 的 token / 配置接口（client_type=web 时返回 accessToken）
NEXT_PUBLIC_LIVEKIT_TOKEN_URL=http://127.0.0.1:8082/api/config

# Phase 32.C: Admin Gateway REST URL — client_web 启动时调
# /api/users 列出可用身份,让操作员从下拉里选(取代旧的"自己输名字"
# 模式)。选定的 user_id 会传给 hub /api/config,然后 LK 用它做
# participant.identity,channel 接到后向 admin 反查 active_agent。
NEXT_PUBLIC_ADMIN_API_URL=http://127.0.0.1:9000

# =============================================
# App 配置
# =============================================
NEXT_PUBLIC_APP_TITLE=Eidolon Agent

# Daemon WebSocket 地址（预留，当前未使用）
# NEXT_PUBLIC_DAEMON_WS_URL=ws://localhost:8080/ws

# =============================================
# Companion (/companion 路由) 配置
# =============================================
# 默认 3D 头像（GLB）。
# 默认值 = /avatar/default.glb（本地托管在 public/avatar/，已随仓库提供）
# 必须包含 morphTargets=ARKit + Oculus Visemes 才能驱动嘴型
# NEXT_PUBLIC_AVATAR_URL=/avatar/default.glb

# TalkingHead 库 CDN 地址。
# 默认走 esm.sh —— 它会自动把 TalkingHead 内部的 bare import（如 "three"）
# 改写成 CDN URL，是浏览器原生 ESM 必需的。jsdelivr 不做这一步会报错。
# 若 esm.sh 在你的网络不可达，可换成镜像（保证仍然会做 bare-import rewrite）：
#   https://esm.run/@met4citizen/talkinghead@1.7      # jsdelivr 系，国内通常较快
#   https://cdn.skypack.dev/@met4citizen/talkinghead@1.7
# NEXT_PUBLIC_TALKINGHEAD_CDN=https://esm.sh/@met4citizen/talkinghead@1.7
